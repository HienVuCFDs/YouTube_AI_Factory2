# Copy this file to .env and add a YouTube Data API v3 key.
YOUTUBE_API_KEY=

# Optional local paths.
YOUTUBE_DATA_DIR=./data
YOUTUBE_DB_PATH=./data/youtube_monitor.db
YOUTUBE_MAX_INITIAL_VIDEOS=100

# Optional verification token for YouTube push subscription handshakes.
YOUTUBE_PUSH_VERIFY_TOKEN=

# Faster-Whisper model for automatic transcript extraction.
# Larger models are more accurate but slower on CPU (tiny, base, small, medium, large-v3).
WHISPER_MODEL_SIZE=base
# auto selects CUDA + float16 when CTranslate2 sees an NVIDIA GPU, otherwise CPU + int8.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# Optional LLM providers for content analysis (alternative to the free local_metadata provider).
# Leave empty to disable a provider; the dashboard hides providers with no key configured.
ANTHROPIC_API_KEY=
# Default is Anthropic's most capable current model. For high-volume batch analysis,
# consider a cheaper model such as claude-sonnet-5 or claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional cloud scene generation. The first adapter uses Runway's video API.
# The dashboard can save these two values to the local .env file without
# revealing the API secret afterwards.
RUNWAYML_API_SECRET=
RUNWAY_MODEL=gen4.5

# Optional local Codex CLI path. Leave empty to auto-detect the CLI installed
# with the Codex/ChatGPT VS Code extension. Sign in once with DANG_NHAP_CODEX.bat.
CODEX_CLI_PATH=

# Optional Google OAuth (Desktop app Client ID) for official YouTube caption access.
# Create at https://console.cloud.google.com/apis/credentials, enable "YouTube Data API v3",
# add http://127.0.0.1:8787/oauth/youtube/callback as an authorized redirect URI.
# Note: captions.download only succeeds for videos the authenticated account owns/manages —
# for other channels you can still list caption tracks, just not download their content.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/oauth/youtube/callback

# Optional production adapters. Leave empty to use dry-run and generate plans only.
# pyVideoTrans CLI adapter. The command receives an SRT file for one segment.
# Placeholders: {text_file} {srt_file} {output_file} {output_dir} {language}
#               {segment_index} {voice_role} {tts_type}
# Example after cloning the official repo:
# PYVIDEOTRANS_COMMAND=uv run cli.py --task tts --name "{srt_file}" --tts_type {tts_type} --voice_role "{voice_role}" --target_language_code {language} --output-dir "{output_dir}"
PYVIDEOTRANS_COMMAND=
PYVIDEOTRANS_ROOT=F:/pyVideoTrans
PYVIDEOTRANS_WORKDIR=
PYVIDEOTRANS_VOICE_ROLE=vi-VN-HoaiMyNeural
PYVIDEOTRANS_TTS_TYPE=0
# Edge TTS fallback uses the same Python environment but bypasses pyVideoTrans/PyTorch.
# It needs an internet connection to Microsoft's TTS service, but no API key.
EDGE_TTS_PYTHON=F:/pyVideoTrans/.venv/Scripts/python.exe
# Optional override. Supported placeholders: {text_file} {output_file} {voice_role}
EDGE_TTS_COMMAND=
# Placeholders supported by FFMPEG_RENDER_COMMAND:
# {manifest_file} {output_file} {project_id}
FFMPEG_RENDER_COMMAND=
# The built-in renderer uses this executable automatically; no command template is needed.
FFMPEG_BINARY=ffmpeg
PRODUCTION_ARTIFACT_DIR=./data/projects
# Maximum size for one local video/audio/image upload (default 2 GiB).
LOCAL_ASSET_MAX_BYTES=2147483648
