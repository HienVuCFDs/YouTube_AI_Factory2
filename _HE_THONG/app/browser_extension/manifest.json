{
  "manifest_version": 3,
  "name": "YT Factory - AI Web Bridge",
  "version": "1.0.0",
  "description": "Dieu phoi Gemini/ChatGPT/Meta AI web (tai khoan da dang nhap trong trinh duyet nay) de tao anh/video cho YouTube AI Factory. Khong dung API tra phi, khong can dang nhap rieng.",
  "permissions": ["tabs", "scripting", "storage", "alarms", "downloads", "debugger"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://www.meta.ai/*",
    "https://labs.google/*",
    "https://*.fbcdn.net/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbsbx.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.gstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content_common.js", "content_gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content_common.js", "content_chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.meta.ai/*"],
      "js": ["content_common.js", "content_agent.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://labs.google/*"],
      "js": ["content_common.js", "content_agent.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
