{
  "manifest_version": 3,
  "name": "YT Factory - AI Web Bridge",
  "version": "1.3.1",
  "description": "Dieu phoi Gemini/ChatGPT/Meta AI web (tai khoan da dang nhap trong trinh duyet nay) de tao anh/video cho YouTube AI Factory. Khong dung API tra phi, khong can dang nhap rieng. Doc trang san pham (Shopee/Lazada/TikTok Shop/Tiki/Sendo) bang phien da dang nhap, chi tra ve noi dung trang - khong tra cookie hay mat khau.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://www.meta.ai/*",
    "https://labs.google/*",
    "https://*.fbcdn.net/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbsbx.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.oaiusercontent.com/*",
    "https://*.gstatic.com/*",
    "https://shopee.vn/*",
    "https://*.shopee.vn/*",
    "https://www.lazada.vn/*",
    "https://*.lazada.vn/*",
    "https://shop.tiktok.com/*",
    "https://tiki.vn/*",
    "https://*.tiki.vn/*",
    "https://www.sendo.vn/*",
    "https://*.sendo.vn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content_common.js",
        "content_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content_common.js",
        "content_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.meta.ai/*"
      ],
      "js": [
        "content_common.js",
        "content_agent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "content_common.js",
        "content_agent.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
