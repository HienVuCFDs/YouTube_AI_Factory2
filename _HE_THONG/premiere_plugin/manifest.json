{
  "manifestVersion": 5,
  "id": "youtube-ai-factory-premiere",
  "name": "YouTube AI Factory",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "YouTube AI Factory"
      },
      "minimumSize": {
        "width": 360,
        "height": 520
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 620
      }
    }
  ]
}
